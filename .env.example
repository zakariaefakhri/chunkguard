# Summary LLM: provider "openai" (also any OpenAI-compatible endpoint via BASE_URL) or "azure"
CHUNKGUARD_LLM_PROVIDER=openai
CHUNKGUARD_LLM_MODEL=gpt-4.1-mini
CHUNKGUARD_LLM_API_KEY=
CHUNKGUARD_LLM_BASE_URL=
CHUNKGUARD_LLM_API_VERSION=

# Embedding model, configured independently of the LLM
CHUNKGUARD_EMBEDDING_PROVIDER=openai
CHUNKGUARD_EMBEDDING_MODEL=text-embedding-3-small
CHUNKGUARD_EMBEDDING_API_KEY=
CHUNKGUARD_EMBEDDING_BASE_URL=
CHUNKGUARD_EMBEDDING_API_VERSION=

# Azure example (MODEL = deployment name):
# CHUNKGUARD_LLM_PROVIDER=azure
# CHUNKGUARD_LLM_BASE_URL=https://<resource>.openai.azure.com
# CHUNKGUARD_LLM_API_VERSION=2024-10-21

# Chunk size limits in characters. Sentences are never cut, so a single
# sentence longer than the maximum stays one chunk.
CHUNKGUARD_MAX_CHUNK_CHARS=2000
CHUNKGUARD_MIN_CHUNK_CHARS=200
