# Used by chunker_from_env(), which needs: pip install "chunkguard[litellm]"
# Models are LiteLLM strings "<provider>/<model>", see https://docs.litellm.ai/docs/providers
# LLM and embedding model are chosen independently, from any provider.

CHUNKGUARD_LLM_MODEL=openai/gpt-4.1-mini
CHUNKGUARD_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional. Unset values fall back to the provider's own variables
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, AWS_*, ...) in the process environment.
CHUNKGUARD_LLM_API_KEY=
CHUNKGUARD_LLM_API_BASE=
CHUNKGUARD_LLM_API_VERSION=
CHUNKGUARD_EMBEDDING_API_KEY=
CHUNKGUARD_EMBEDDING_API_BASE=
CHUNKGUARD_EMBEDDING_API_VERSION=

# Other setups, for example:
# CHUNKGUARD_LLM_MODEL=anthropic/claude-sonnet-5-5
# CHUNKGUARD_LLM_MODEL=gemini/gemini-2.5-flash
# CHUNKGUARD_LLM_MODEL=azure/<deployment>            + API_BASE and API_VERSION
# CHUNKGUARD_LLM_MODEL=ollama/llama3.1                 (local, API_BASE=http://localhost:11434)
# CHUNKGUARD_EMBEDDING_MODEL=cohere/embed-multilingual-v3.0
# CHUNKGUARD_EMBEDDING_MODEL=mistral/mistral-embed
# CHUNKGUARD_EMBEDDING_MODEL=openai/<model>            + API_BASE for any OpenAI-compatible server

# Texts per embedding request; lower it if your provider rejects large batches.
CHUNKGUARD_EMBEDDING_BATCH_SIZE=64

# Per request, for LLM and embedding calls alike.
CHUNKGUARD_REQUEST_TIMEOUT=120
CHUNKGUARD_MAX_RETRIES=2

# Chunk size limits; 0 switches a limit off (the paper uses none).
# Sentences are never cut, so a single sentence longer than the maximum stays one chunk.
# MIN merges chunks shorter than this into a neighbour; off by default.
CHUNKGUARD_MAX_CHUNK_LENGTH=2000
CHUNKGUARD_MIN_CHUNK_LENGTH=0

# Unit of the limits: chars (default) or tokens (needs: pip install "chunkguard[tokens]").
CHUNKGUARD_LENGTH_UNIT=chars
CHUNKGUARD_TOKEN_ENCODING=o200k_base

# Longer documents reach the LLM as evenly spread excerpts of this total size;
# 0 sends the whole document.
CHUNKGUARD_SUMMARY_MAX_CHARS=100000
